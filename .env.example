# Copy to .env.local. Never commit real values: this repository is public.

# Public base URL of the app, used for redirects and links
APP_URL=http://localhost:3000

# Supabase (EU region). The service role key is used only on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe, for damage holds (manual capture)
STRIPE_SECRET_KEY=
DAMAGE_HOLD_EUR=200

# Host dashboard login (HTTP basic auth)
HOST_USER=host
HOST_PASSWORD=

# Shown in the guidebook. Keep these out of the code.
GUEST_WIFI_NAME=
GUEST_WIFI_PASSWORD=
HOST_WHATSAPP=+385...

# Link to the apartment's Google review page (no incentive is ever attached to it)
GOOGLE_REVIEW_URL=
